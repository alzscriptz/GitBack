# Only what the Actions backend actually needs
PORT=4000

# Simple shared secret the frontend sends in the header
# (X-API-Key: your-secret-here)
API_KEY=change-me-to-a-long-random-string

# GitHub token that can write to the private build-engine repo
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-private-build-engine-repo

# Where finished artifacts are stored on disk
ARTIFACTS_DIR=./artifacts-store
