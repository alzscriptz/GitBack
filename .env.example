# Only what the Actions backend actually needs
PORT=4000

# Shared secret — put the SAME value in the site Settings → API Key
# (header: X-API-Key)
API_KEY=change-me-to-a-long-random-string

# GitHub PAT (classic) with scopes: repo + workflow
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Private build-engine (already created for you)
GITHUB_OWNER=alzscriptz
GITHUB_REPO=build-engine

ARTIFACTS_DIR=./artifacts-store
