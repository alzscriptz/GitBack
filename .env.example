# Copy to .env and fill in real values
PORT=4000

# Simple site login (change these!)
SITE_USERNAME=admin
SITE_PASSWORD=change-me-to-something-strong
JWT_SECRET=super-long-random-secret-change-me-in-production

# GitHub (the real build engine)
# Create a fine-grained PAT or classic token with:
#   repo (full), workflow, actions:read, actions:write
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-private-build-repo   # a private repo that will receive the workflow + source temporarily

# Optional: where artifacts are stored on disk (defaults to ./artifacts-store)
ARTIFACTS_DIR=./artifacts-store

# Frontend origin for CORS (later when we build the liquid-glass site)
FRONTEND_ORIGIN=http://localhost:3000
